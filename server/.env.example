# LEDGORA backend configuration.
# Copy to `server/.env` (git-ignored) for local development.
# NEVER commit real values. Nothing here belongs in a VITE_ variable — those are
# inlined into the public frontend bundle.

NODE_ENV=development
PORT=3000
# Render sets PORT itself; the server always binds 0.0.0.0.
HOST=0.0.0.0

# PostgreSQL connection string.
# Leave EMPTY in local development to use the in-process PGlite database
# (real PostgreSQL, nothing to install, not persisted). Required in production.
DATABASE_URL=

# Exact origin(s) allowed to make credentialed requests. Comma-separated.
# With the same-origin proxy this is the FRONTEND origin (the browser's Origin).
# Production example: https://ledgora-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Cross-site behaviour of the session/CSRF cookies.
#   lax  — same-origin deployment (browser reaches the API through /api). DEFAULT.
#   none — cross-site deployment (browser talks to a different API hostname).
#          The browser only honours SameSite=None on a Secure cookie, so this is
#          production-only and requires TRUST_PROXY=true.
COOKIE_SAMESITE=lax
# Emit `Partitioned` (CHIPS) with SameSite=None, so a cross-site session keeps
# working as third-party cookies are phased out. Only meaningful with `none`.
COOKIE_PARTITIONED=false

# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The server refuses to start in production while this is the default.
SESSION_SECRET=replace-me
SESSION_TTL_HOURS=24
# How long an emailed password-reset link stays usable.
PASSWORD_RESET_TTL_MINUTES=30

# ── Transactional email (Resend) ─────────────────────────────────────────────
# The endpoint is a constant the server knows, so the key and the sender are all
# that is required. Both are needed before any mail is attempted; setting only
# one is refused at boot in production, because a half-configured mailer that
# fails every send silently is how password resets vanish behind a cheerful
# "instructions have been sent".
#
# RESEND_API_KEY is backend-only: never returned by an API response, never
# logged, never sent to the browser. EMAIL_FROM accepts a bare address or
# "Display Name <address>", on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Ledgora <no-reply@ledgora.example>

# The ONE origin every emailed link is built from (reset and invitation alike).
# Distinct from FRONTEND_URL, which is a CORS allow-list and may hold several
# origins — a link has to name exactly one. Defaults to the first allowed origin.
APP_PUBLIC_URL=http://localhost:5173

# Provider-neutral aliases for the same settings, for a Resend-compatible
# provider that is not Resend. An explicit MAIL_* value always wins.
# MAIL_PROVIDER_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# MAIL_FROM=no-reply@ledgora.example

# Requests per window for POST /api/auth/forgot-password. Tighter than login on
# purpose: the endpoint cannot enumerate accounts, but each accepted call posts
# mail to a third party.
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# Payment-proof storage (local development adapter).
UPLOAD_DIRECTORY=./storage/payment-proofs
MAX_UPLOAD_BYTES=5242880

# Set true only when running behind Render's proxy, so client IPs are correct.
TRUST_PROXY=false

# Login protection.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCK_THRESHOLD=8
ACCOUNT_LOCK_MINUTES=15

# ── First-administrator bootstrap ────────────────────────────────────────────
# For the initial Render deploy only, where no terminal is available.
# Prefer `npm run create-platform-admin` for everyday administration.
# Enable, deploy once, then REMOVE the password and set ENABLED back to false.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=

# ── JoFotara clearance MOCK (development only) ───────────────────────────────
# Mounts POST /api/mock/jofotara/submit and GET /api/mock/jofotara/health.
#
# The mock fabricates clearance verdicts. That is fine for exercising our own
# submission path and dangerous the moment a fabricated CLEARED is stored as a
# compliance record, so `config/env.ts` REFUSES this flag in production rather
# than ignoring it — the server will not boot with it on.
#
# Every response it returns carries `"mock": true` and a `mock-` prefixed uuid.
# Persist those alongside any stored clearance result.
MOCK_JOFOTARA=false
# normal | always-error | always-rejected. Per-request overrides win:
#   ?status=rejected   or   X-Mock-Status: error
MOCK_JOFOTARA_MODE=normal
